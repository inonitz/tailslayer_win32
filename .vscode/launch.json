{
    "configurations": [
    {
        "name": "Debug Tailslayer Sandbox",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/bin/tailslayer_sandbox",
        "args": [
            "--arm", "single_stress",
            "--samples", "20000000",
            "--stress-threads", "8",
            "--channels", "1"
        ],
        // "cwd": "${workspaceFolder}/build/bin",
        "stopOnEntry": false,
        "stdio": ["output3.log", "output3.log", "output3.log"],
        "postRunCommands": []
    },

    {
        "name": "Debug Tailslayer Probe",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/bin/tailslayer_probe",
        "args": [
            "--trefi-us", "7.8",
            "--thresh-mult", "2"
        ],
        // "cwd": "${workspaceFolder}/build/bin",
        "stopOnEntry": false,
        "stdio": ["output_probe.log", "output_probe.log", "output_probe.log"],
        "postRunCommands": []
    },
    {
        "name": "Debug Tailslayer Benchmark",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/bin/tailslayer_benchmark",
        "args": [
            "--arm", "dual_quiet",
            "--samples", "500000",
            "--stress-threads", "4",
            "--channels", "4",
            "--channel-bit", "8",
            "--raw-prefix", "quiet4_bit8_channel4"
        ],
        // "cwd": "${workspaceFolder}/build/bin",
        "stopOnEntry": false,
        "stdio": ["output3.log", "output3.log", "output3.log"],
        "postRunCommands": []
    }
    ]
}