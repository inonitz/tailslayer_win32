{
    "configurations": [
    {
        "name": "Debug Tailslayer Sandbox",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/bin/tailslayer_sandbox",
        "args": [
            "--arm", "single_stress",
            "--samples", "20000000",
            "--stress-threads", "8",
            "--channels", "1"
        ],
        // "cwd": "${workspaceFolder}/build/bin",
        "stopOnEntry": false,
        "stdio": ["output3.log", "output3.log", "output3.log"],
        "postRunCommands": []
    },

    {
        "name": "Debug Tailslayer Probe",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/bin/tailslayer_probe",
        "args": [
            "--trefi-us", "7.8",
            "--thresh-mult", "2"
        ],
        // "cwd": "${workspaceFolder}/build/bin",
        "stopOnEntry": false,
        "stdio": ["output_probe.log", "output_probe.log", "output_probe.log"],
        "postRunCommands": []
    },
    {
        "name": "Debug Tailslayer Benchmark",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/build/bin/tailslayer_benchmark",
        "args": [
            "--arm", "multi_ch_quiet",
            "--samples", "5000000",
            "--stress-threads", "4",
            "--channels", "4",
            "--channel-bit", "12",
            "--raw-prefix", "quiet4_bit12_channel4"
        ],
        // "cwd": "${workspaceFolder}/build/bin",
        "stopOnEntry": false,
        "stdio": ["output0.log", "stdout.txt", "stderr.txt"],
        "postRunCommands": []
    }
    ]
}